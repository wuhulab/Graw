# 统一编辑器格式配置（https://editorconfig.org）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python：PEP 8 四空格缩进
[*.py]
indent_style = space
indent_size = 4

# 前端（JS / Vue / CSS / HTML / JSON / YAML / MD）：两空格缩进
[*.{js,jsx,ts,vue,css,scss,html,json,yaml,yml,md}]
indent_style = space
indent_size = 2

# Makefile 必须使用 Tab
[Makefile]
indent_style = tab

# Windows 脚本保留 CRLF
[*.{bat,cmd,ps1}]
end_of_line = crlf